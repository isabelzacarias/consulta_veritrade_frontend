# Copia este archivo a .env para cambiar los valores del build.
# No contiene secretos.

FRONTEND_PORT=8080
VERITRADE_NETWORK=veritrade_vps_net

VITE_API_URL=/compras/api
# En la primera prueba del proxy se puede dejar false.
# Cámbialo a true cuando el SSO de la suite esté desplegado.
VITE_AUTH_ENABLED=false
VITE_AUTH_APP=compras
VITE_AUTH_CONTEXT_URL=/api/auth/context.php
VITE_AUTH_LOGIN_URL=/login.php
VITE_AUTH_LOGOUT_URL=/logout.php
VITE_SUITE_URL=/
