# URL base de la API. En desarrollo se deja vacío para usar el proxy de Vite (/api).
# En despliegue, por ejemplo: VITE_API_URL=https://api.midominio.com
VITE_API_URL=

# URL de la suite PHP para el enlace "Suite" y la ruta /suite.
# Si se omite, se deriva del origen de VITE_AUTH_CONTEXT_URL.
VITE_SUITE_URL=http://localhost:8000
# Producción: VITE_SUITE_URL=https://suite.midominio.com

# Destino del proxy de Vite (solo desarrollo). Útil si el backend corre en otro host.
# En Docker: http://host.docker.internal:8001
VITE_PROXY_TARGET=http://127.0.0.1:8001

# SSO con la suite PHP.
# En local se puede dejar desactivado para trabajar sin la suite.
# En producción usar true y apuntar al contexto real de la suite.
VITE_AUTH_ENABLED=false
VITE_AUTH_APP=compras
VITE_AUTH_CONTEXT_URL=
VITE_AUTH_LOGIN_URL=
VITE_AUTH_LOGOUT_URL=

# Ejemplo de producción:
# VITE_AUTH_ENABLED=true
# VITE_AUTH_CONTEXT_URL=https://suite.midominio.com/api/auth/context.php
# VITE_AUTH_LOGIN_URL=https://suite.midominio.com/login.php
# VITE_AUTH_LOGOUT_URL=https://suite.midominio.com/logout.php
