# Ejemplo de Nginx para VPS con same-origin.
# Copiar a /etc/nginx/sites-available/veritrade.conf, ajustar placeholders
# y enlazar en /etc/nginx/sites-enabled/.
#
# Supuestos:
# - Nginx corre en el host.
# - PHP-FPM sirve la suite.
# - FastAPI publica 127.0.0.1:8001.
# - El build de la SPA está en /var/www/veritrade/compras.

server {
    listen 80;
    server_name suite.<dominio>;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name suite.<dominio>;

    ssl_certificate     /etc/letsencrypt/live/suite.<dominio>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/suite.<dominio>/privkey.pem;

    root /var/www/horbismex-app;
    index index.php;

    server_tokens off;
    client_max_body_size 50m;

    location = /compras {
        return 308 /compras/;
    }

    # FastAPI. El slash final elimina /compras/api/ antes del backend.
    location /compras/api/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    # SPA estática con fallback para deep links de React Router.
    location /compras/ {
        alias /var/www/veritrade/compras/;
        try_files $uri $uri/ /compras/index.html;
    }

    # Suite PHP. Incluye /api/auth/context.php y login/logout.
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php<version>-fpm.sock;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
